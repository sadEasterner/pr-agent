# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost:8080
# Production publish addresses (host:port). Live box uses 8110/8111.
API_PUBLISH=127.0.0.1:8110
DASHBOARD_PUBLISH=8111

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://prmanager:prmanager@localhost:5432/prmanager

# Git host: gitea | github | gitlab  (forgejo uses gitea)
SCM_PROVIDER=gitea
SCM_BASE_URL=https://gitea.example.com
SCM_TOKEN=
SCM_WEBHOOK_SECRET=
SCM_API_TIMEOUT_SECONDS=30
# Optional: poll these repos when Gitea webhooks time out (comma-separated)
SCM_SYNC_REPOSITORIES=
SCM_SYNC_INTERVAL_SECONDS=60

# Legacy Gitea names still work if SCM_* is empty
GITEA_BASE_URL=https://gitea.example.com
GITEA_TOKEN=
GITEA_WEBHOOK_SECRET=
GITEA_API_TIMEOUT_SECONDS=30

# AI reviewer (used only for PR checking)
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_DIFF_CHARS=80000
AI_MAX_FILES=40
AI_CHUNK_SIZE=12000

# Dashboard
VITE_API_BASE_URL=http://localhost:8000

# Admin login (do not commit real values)
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=false
